import QtQuick.tooling 1.2

Module {
    dependencies: ["QtQml 6.0", "QtQuick 6.0"]
    Component {
        name: "GXView3D"
        className: "gx::gx3d::GXView3D"
        prototype: "QObject"
        exports: ["GenesisX3D/GXView3D 1.0"]
        Enum {
            name: "RenderMode"
            values: [
                "OnDemand",
                "Continuous",
                "Throttled"
            ]
        }

        Property {
            name: "objectName"
            type: "string"
        }
        Property {
            name: "anchors"
            type: "QQuickAnchors"
            isReadonly: true
            isPointer: true
        }
        Property {
            name: "width"
            type: "QQuickWidth"
            isReadonly: true
            // isPointer: true
        }
        Property {
            name: "height"
            type: "QQuickHeight"
            isReadonly: true
            // isPointer: true
        }
        Property {
            name: "clearColor"
            type: "string"
        }

        Property {
            name: "renderMode"
            type: "RenderMode"
            read: "renderMode"
            notify: "renderModeChanged"
        }
        Property {
            name: "targetFps"
            type: "int"
            read: "targetFps"
            notify: "targetFpsChanged"
        }

        Property {
            name: "scene"
            type: "gx::gx3d::scene::GXScene"
            read: "scene"
            notify: "sceneChanged"
        }
        Property {
            name: "camera"
            type: "gx::gx3d::GXCamera"
            read: "camera"
            notify: "cameraChanged"
        }
        Property {
            name: "environment"
            type: "gx::gx3d::render::GXEnvironment"
            read: "environment"
            notify: "environmentChanged"
        }
        Method {
            name: "pick"
            type: "QObject"
            parameter: {
                name: "x"
                type: "float"
            }
            parameter: {
                name: "y"
                type: "float"
            }
        }
        Signal {
            name: "picked"
            type: "void"
            parameter: {
                name: "node"
                type: "QObject"
            }
            parameter: {
                name: "positionWS"
                type: "QVector3D"
            }
            parameter: {
                name: "distance"
                type: "float"
            }
        }
    }
}
