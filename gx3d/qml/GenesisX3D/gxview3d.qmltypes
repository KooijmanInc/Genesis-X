import QtQuick.tooling 1.2

Module {
    dependencies: ["QtQml 6.0", "QtQuick 6.0"]
    Component {
        name: "GXView3D"
        className: "gx::gx3d::GXView3D"
        prototype: "QObject"
        exports: ["GenesisX3D/GXView3D 1.0"]
        Property {
            name: "objectName"
            type: "string"
        }
        Property {
            name: "anchors"
            type: "QQuickAnchors"
            isReadonly: true
            isPointer: true
        }
        Property {
            name: "clearColor"
            type: "string"
        }

        Property {
            name: "renderMode"
            type: "gx::gx3d::GXView3D"
        }
        Property {
            name: "scene"
            type: "gx::gx3d::scene::GXScene"
        }
        Property {
            name: "camera"
            type: "gx::gx3d::GXCamera"
        }
        Method {
            name: "pick"
            type: "QObject"
            parameter: {
                name: "x"
                type: "float"
            }
            parameter: {
                name: "y"
                type: "float"
            }
        }
        Signal {
            name: "picked"
            type: "void"
            parameter: {
                name: "node"
                type: "QObject"
            }
            parameter: {
                name: "positionWS"
                type: "QVector3D"
            }
            parameter: {
                name: "distance"
                type: "float"
            }
        }
    }
}
