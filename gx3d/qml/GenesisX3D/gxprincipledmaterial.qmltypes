import QtQuick.tooling 1.2

Module {
    dependencies: ["QtQml 6.0", "QtQuick 6.0"]
    Component {
        name: "GXPrincipledMaterial"
        className: "gx::gx3d::render::GXPrincipledMaterial"
        prototype: "QObject"
        exports: ["GenesisX3D/GXPrincipledMaterial 1.0"]
        Enum {
            name: "AlphaMode"
            values: [
                "Default",
                "Opaque",
                "Mask",
                "Blend"
            ]
        }
        Property {
            name: "baseColor"
            type: "string"
            read: "baseColor"
            notify: "baseColorChanged"
        }
        Property {
            name: "baseColorTexture"
            type: "string"
            read: "baseColorTexture"
            notify: "baseColorTextureChanged"
        }
        Property {
            name: "normalTexture"
            type: "string"
            read: "normalTexture"
            notify: "normalTextureChanged"
        }
        Property {
            name: "emissionColor"
            type: "string"
            read: "emissionColor"
            notify: "emissionColorChanged"
        }
        Property {
            name: "emissionStrength"
            type: "float"
            read: "emissionStrength"
            notify: "emissionStrengthChanged"
        }
        Property {
            name: "emissionLightIntensity"
            type: "float"
            read: "emissionLightIntensity"
            notify: "emissionLightIntensityChanged"
        }
        Property {
            name: "emissionLightRadius"
            type: "float"
            read: "emissionLightRadius"
            notify: "emissionLightRadiusChanged"
        }
        Property {
            name: "alphaMode"
            type: "AlphaMode"
            read: "alphaMode"
            notify: "alphaModeChanged"
        }
        Property {
            name: "gamma"
            type: "QVector3D"
            read: "gamma"
            notify: "gammaChanged"
        }
        Property {
            name: "normalScale"
            type: "double"
            read: "normalScale"
            notify: "normalScaleChanged"
        }
    }
}
