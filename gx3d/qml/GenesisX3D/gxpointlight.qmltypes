import QtQuick.tooling 1.2

Module {
    dependencies: ["QtQml 6.0", "QtQuick 6.0"]
    Component {
        name: "GXPointLight"
        className: "gx::gx3d::render::GXPointLight"
        prototype: "QObject"
        exports: ["GenesisX3D/GXPointLight 1.0"]
        Property {
            name: "objectName"
            type: "string"
        }
        Property {
            name: "color"
            type: "QColor"
        }
        Property {
            name: "position"
            type: "QVector3D"
        }
        Property {
            name: "intensity"
            type: "float"
        }
        Property {
            name: "range"
            type: "float"
        }
        Property {
            name: "x"
            type: "float"
            read: "x"
            notify: "xChanged"
        }
        Property {
            name: "y"
            type: "float"
            read: "y"
            notify: "yChanged"
        }
        Property {
            name: "z"
            type: "float"
            read: "z"
            notify: "zChanged"
        }
    }
}
