!defined(__GX_FRAMEWORK_PRF_INCLUDED__, var) {
    __GX_FRAMEWORK_PRF_INCLUDED__ = 1

    message([genesisx_framework] module loaded from $$PWD)

    GX_FRAMEWORK_INC_ROOT = $$clean_path($$GENESISX_BUILD_ROOT/framework/include)

    INCLUDEPATH += $$GX_FRAMEWORK_INC_ROOT $$clean_path($$GENESISX_BUILD_ROOT/core/include)
    QMAKE_LIBDIR += $$LIBDIRS

    GX_ABI = $$QT_ARCH
    isEmpty(GX_ABI): GX_ABI = arm64-v8a
    contains(GX_ABI, arm64) {
        GX_ABI = arm64-v8a
    } else: contains(GX_ABI, x86_64) {
        GX_ABI = x86_64
    }

    android {
        # !contains(LIBS, -lgenesisx_$${GX_ABI}) {
        LIBS += -lgenesisx_framework_$${GX_ABI}

        message([genesisx_framework] setting framework lib -lgenesisx_framework_$${GX_ABI})
        # }
    } else {
        # !contains(LIBS, -lgenesisx) {
        #     LIBS += -lgenesisx
        #     include(gx_core_sub.prf)
        #     message(here arrived $$GX_SO)
        # }
        LIBS += -lgenesisx_framework

        message([genesisx_framework] setting framework lib -lgenesisx_framework)
    }

    win32 {
        GX_DLL_FRAMEWORK = $$shell_path($$LIBDIRS/genesisx_framework.dll)
        GX_DLL_FRAMEWORK_DEST = $$shell_path($$DEST_LIBDIRS/genesisx_framework.dll)
        GX_A_FRAMEWORK = $$shell_path($$LIBDIRS/libgenesisx_framework.a)
        GX_A_FRAMEWORK_DEST = $$shell_path($$DEST_LIBDIRS/libgenesisx_framework.a)

        exists($$GX_DLL_FRAMEWORK) {
            QMAKE_POST_LINK += $$escape_expand(\\n\\t)$(COPY_FILE) $$shell_quote($$GX_DLL_FRAMEWORK) $$shell_quote($$GX_DLL_FRAMEWORK_DEST)
            message([genesisx_framework] framework library .dll file copied to $$DEST_LIBDIRS)
        }
        exists($$GX_A_FRAMEWORK) {
            QMAKE_POST_LINK += $$escape_expand(\\n\\t)$(COPY_FILE) $$shell_quote($$GX_A_FRAMEWORK) $$shell_quote($$GX_A_FRAMEWORK_DEST)
            message([genesisx_framework] framework library $$GX_A_FRAMEWORK $$GX_FRAMEWORK_A file copied to $$DEST_LIBDIRS)
        }
    }

    android {
        GX_FRAMEWORK_SO = $$shell_path($$LIBDIRS/libgenesisx_framework_$${GX_ABI}.so)
        GX_FRAMEWORK_SO_DEST = $$shell_path($$DEST_LIBDIRS/libgenesisx_framework_$${GX_ABI}.so)
        exists($$GX_FRAMEWORK_SO) {
            QMAKE_POST_LINK += $$escape_expand(\\n\\t)$(COPY_FILE) $$shell_quote($$GX_FRAMEWORK_SO) $$shell_quote($$GX_FRAMEWORK_SO_DEST)
            message([genesisx_framework] library .so file copied to $$DEST_LIBDIRS)
        }

        ANDROID_EXTRA_LIBS += $$GX_FRAMEWORK_SO
    }
}
